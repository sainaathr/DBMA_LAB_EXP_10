# .env.example — copy this to .env and fill in real values
# NEVER commit the .env file itself (it is in .gitignore)

# MySQL Database Connection
DB_URL=jdbc:mysql://localhost:3306/diagnostic_center?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=dcadmin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Server port (default 8080)
PORT=8080
